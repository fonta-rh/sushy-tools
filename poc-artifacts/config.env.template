# sushy-tools EC2 driver deployment config
# Copy to config.env, fill in, then: source config.env && ./deploy.sh

# --- Required ---

# AWS CLI profile (must have ec2:RunInstances, ec2:CreateSecurityGroup, etc.)
export AWS_PROFILE="my-profile"

# AWS region — used for both the sushy-tools host and the EC2 driver
export AWS_REGION="us-east-1"

# --- Optional: instance types ---

# sushy-tools host (just runs Python + boto3 — doesn't need much)
#export SUSHY_HOST_TYPE="t3.small"

# Fencing target nodes. Use *.metal* for bare metal timing tests,
# or t3.micro/t3.small for cheap driver validation.
#export NODE_TYPE="c6g.metal"

# Set to "false" to skip node creation (point at existing instances instead)
#export DEPLOY_NODES="true"

# Number of fencing target nodes (default: 2)
#export NODE_COUNT="2"

# --- Optional: networking ---

# VPC and subnet to launch into. If unset, uses the default VPC.
# Set these to match your bare metal instances so the cluster nodes
# can reach sushy-tools on port 8000.
#export VPC_ID="vpc-0abc123"
#export SUBNET_ID="subnet-0abc123"

# --- Optional: SSH ---

# SSH public key to inject (default: ~/.ssh/id_ed25519.pub)
#export SSH_KEY_PATH="$HOME/.ssh/id_ed25519.pub"

# --- Optional: IAM ---

# IAM instance profile name — gives the sushy-tools host EC2 API access
# for the driver (ec2:DescribeInstances, Start/Stop/RebootInstances).
# If unset, you must provide AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY below.
#export INSTANCE_PROFILE="my-ec2-role"

# Explicit AWS credentials for the EC2 driver (only if no instance profile).
# Written to ~/sushy-tools.conf on the remote host.
#export SUSHY_AWS_ACCESS_KEY="AKIA..."
#export SUSHY_AWS_SECRET_KEY="..."

# --- Optional: instance filtering ---

# Tag filter to scope which EC2 instances sushy-tools manages.
# Without this, the driver lists ALL instances in the region.
# Auto-set to sushy-cluster=$USER when DEPLOY_NODES=true.
#export FILTER_TAG="tnt-cluster"
#export FILTER_VALUE="$USER"
